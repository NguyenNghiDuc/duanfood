<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Ticket #<%= ticket.id %></title></head><body><main class="app-shell"><section class="page-card"><div class="page-heading"><div><span class="eyebrow">CSKH</span><h1>#<%= ticket.id %> · <%= ticket.subject %></h1><p>Khách: <strong><%= ticket.username %></strong> · <%= ticket.status %></p></div><a class="btn btn-secondary" href="/admin/tickets">Danh sách ticket</a></div><div class="chat-thread"><% messages.forEach(m=>{ %><div class="chat-bubble <%= m.sender_role==='user'?'from-user':'from-staff' %>"><strong><%= m.sender %> · <%= m.sender_role %></strong><p><%= m.message %></p><small><%= m.created_at %></small></div><% }) %></div><% if(ticket.status!=='closed'){ %><form method="post" action="/admin/tickets/<%= ticket.id %>/reply" class="reply-box"><textarea name="message" rows="4" required placeholder="Phản hồi khách hàng..."></textarea><button class="btn">Gửi phản hồi</button></form><form method="post" action="/admin/tickets/<%= ticket.id %>/close" style="margin-top:12px"><button class="btn btn-danger">Đóng ticket</button></form><% } %></section></main></body></html>