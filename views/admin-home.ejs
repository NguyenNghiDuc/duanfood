<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>MINI FOOD Admin</title><link rel="stylesheet" href="/css/admin-stats.css"></head><body><div class="admin-dashboard"><aside class="sidebar"><div class="brand"><span class="brand-logo">F</span><div><h1>Food Admin</h1><p><%= user.role||'admin' %></p></div></div><nav class="sidebar-nav"><a class="active" href="/admin">Tổng quan</a><a href="/admin/insights">Business Insights + AI</a><a href="/admin/orders">Đơn hàng</a><a href="/admin/inventory">Tồn kho</a><a href="/admin/vouchers">Voucher</a><a href="/admin/flash-sales">Flash Sale</a><a href="/admin/topups">Duyệt nạp tiền</a><a href="/admin/users">Người dùng & quyền</a><a href="/admin/tickets">CSKH / Ticket</a><a href="/admin/audit">Audit log</a><a href="/admin/categories">Danh mục</a><a href="/admin/foods">Sản phẩm</a><a href="/ai">AI Chat</a><a href="/">Trang khách</a><a href="/logout" class="logout-link">Đăng xuất</a></nav></aside><main class="dashboard-content"><header class="dashboard-header"><div><p class="subtitle">Trung tâm vận hành</p><h1>MINI FOOD Admin</h1><p>Đăng nhập với quyền: <strong><%= user.role||'admin' %></strong></p></div></header><section class="summary-grid"><article class="summary-card"><p class="summary-label">Đơn hàng</p><h2><%= totalOrders||0 %></h2><span>Quản lý trạng thái & hoàn tiền</span></article><article class="summary-card highlight"><p class="summary-label">Doanh thu</p><h2><%= Number(totalRevenue||0).toLocaleString('vi-VN') %>đ</h2><span>Không tính đơn hủy</span></article><article class="summary-card"><p class="summary-label">Sản phẩm</p><h2><%= foodCount||0 %></h2><span>Tồn kho & flash sale</span></article><article class="summary-card"><p class="summary-label">Danh mục</p><h2><%= categoryCount||0 %></h2><span>Kho danh mục hiện tại</span></article></section><section class="dashboard-panels"><div class="panel chart-panel"><div class="panel-header"><h2>Vận hành</h2><span>Các module mới</span></div><div class="chart-placeholder"><span>Voucher · Ví · Tồn kho · CSKH · Audit · PWA · AI quản trị</span></div></div><div class="panel best-panel"><div class="panel-header"><h2>Truy cập nhanh</h2></div><ul class="best-list"><li><a href="/admin/insights">Dashboard nâng cao</a></li><li><a href="/admin/topups">Duyệt nạp tiền</a></li><li><a href="/admin/inventory">Cảnh báo tồn kho</a></li><li><a href="/admin/tickets">Ticket đang chờ</a></li><li><a href="/admin/vouchers">Tạo voucher</a></li></ul></div></section></main></div></body></html>