<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= food.title %></title></head><body><main class="app-shell"><section class="page-card"><div class="page-heading"><div><span class="eyebrow"><%= food.category_name||'MÓN ĂN' %></span><h1><%= food.title %></h1></div><a class="btn btn-secondary" href="/foods">← Danh sách món</a></div><div class="dashboard-grid"><div class="panel"><% if(food.image){ %><img style="width:100%;max-height:430px;object-fit:cover;border-radius:16px" src="<%= food.image %>" alt="<%= food.title %>"><% } %></div><div class="panel"><% if(food.flash_sale){ %><span class="badge">🔥 FLASH SALE</span><p><del><%= Number(food.original_price).toLocaleString('vi-VN') %>đ</del></p><p class="price"><%= Number(food.display_price).toLocaleString('vi-VN') %>đ</p><small>Kết thúc: <%= food.flash_sale.ends_at %></small><% }else{ %><p class="price"><%= Number(food.display_price||food.price).toLocaleString('vi-VN') %>đ</p><% } %><p><%= food.description||'' %></p><p>Tồn kho: <strong><%= Number(food.stock??50) %></strong></p><div class="actions"><form method="post" action="/cart/add/<%= food.id %>"><button class="btn" <%= Number(food.stock??50)<=0?'disabled':'' %>><%= Number(food.stock??50)<=0?'Hết hàng':'Thêm vào giỏ' %></button></form><% if(user){ %><form method="post" action="/favorites/<%= food.id %>/toggle"><button class="btn btn-secondary"><%= isFavorite?'♥ Đã yêu thích':'♡ Yêu thích' %></button></form><% } %></div><div id="recommendations" style="margin-top:24px"></div></div></div></section><section class="page-card" style="margin-top:20px"><div class="page-heading"><div><span class="eyebrow">ĐÁNH GIÁ ĐÃ MUA</span><h2><%= Number(ratingSummary.avgRating||0).toFixed(1) %>/5 · <%= ratingSummary.reviewCount %> đánh giá</h2></div></div><% if(user&&canReview){ %><form method="post" action="/foods/<%= food.id %>/review" enctype="multipart/form-data" class="form-card"><label>Số sao<select name="rating"><option>5</option><option>4</option><option>3</option><option>2</option><option>1</option></select></label><label>Nhận xét<textarea name="comment" rows="4" maxlength="2000" placeholder="Chia sẻ trải nghiệm thật sau khi mua..."></textarea></label><label>Ảnh món ăn (tùy chọn)<input type="file" name="image" accept="image/jpeg,image/png,image/webp"></label><button class="btn">Gửi / cập nhật đánh giá</button></form><% }else if(user){ %><p class="notice">Bạn cần mua món này trước khi đánh giá.</p><% }else{ %><p>Vui lòng <a href="/login"><strong>đăng nhập</strong></a> để đánh giá.</p><% } %><div class="stack-list" style="margin-top:18px"><% if(!(reviews&&reviews.length)){ %><div class="empty-state">Chưa có đánh giá.</div><% } %><% (reviews||[]).forEach(r=>{ %><article class="notice-card"><div><strong><%= r.username %> · <%= '★'.repeat(Number(r.rating||0)) %></strong><p><%= r.comment||'' %></p><small><%= r.created_at||'' %></small></div><% if(r.image){ %><img src="<%= r.image %>" alt="Ảnh đánh giá" style="width:110px;height:90px;object-fit:cover;border-radius:12px"><% } %></article><% }) %></div><nav class="page-nav"><% if(reviewPage>1){ %><a href="/foods/<%= food.id %>?reviewPage=<%= reviewPage-1 %>#reviews">← Review trước</a><% } %><span>Trang review <strong><%= reviewPage %></strong></span><% if(reviewHasNext){ %><a href="/foods/<%= food.id %>?reviewPage=<%= reviewPage+1 %>#reviews">Review sau →</a><% } %></nav></section></main><script>fetch('/api/recommendations/<%= food.id %>').then(r=>r.json()).then(j=>{if(!j.recommendations?.length)return;document.getElementById('recommendations').innerHTML='<h3>Gợi ý ăn kèm</h3><div class="stack-list">'+j.recommendations.slice(0,3).map(x=>`<a class="alert-row" href="/foods/${x.id}"><span>${x.title}</span><strong>${Number(x.display_price||x.price).toLocaleString('vi-VN')}đ</strong></a>`).join('')+'</div>'}).catch(()=>{});</script></body></html>