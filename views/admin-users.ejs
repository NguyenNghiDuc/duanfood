<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Quản lý người dùng</title></head><body><main class="app-shell"><section class="page-card"><div class="page-heading"><div><span class="eyebrow">ADMIN</span><h1>Người dùng & phân quyền</h1></div><a class="btn btn-secondary" href="/admin">Dashboard</a></div><form class="filter-bar"><input name="q" value="<%= q %>" placeholder="Tìm username hoặc họ tên"><button class="btn">Tìm</button></form><div class="table-wrap"><table><thead><tr><th>User</th><th>Họ tên</th><th>Số dư</th><th>Role / Khóa</th><th>Điều chỉnh ví</th></tr></thead><tbody><% users.forEach(u=>{ %><tr><td><strong><%= u.username %></strong><br><small><%= u.email||'' %> <%= u.phone||'' %></small></td><td><%= u.fullname||'' %></td><td><%= Number(u.balance||0).toLocaleString('vi-VN') %>đ</td><td><form method="post" action="/admin/users/<%= encodeURIComponent(u.username) %>/access" class="inline-form"><select name="role"><% ['user','support','kitchen','staff','admin','super_admin'].forEach(r=>{ %><option value="<%= r %>" <%= u.role===r?'selected':'' %>><%= r %></option><% }) %></select><select name="locked"><option value="0" <%= !Number(u.locked)?'selected':'' %>>Hoạt động</option><option value="1" <%= Number(u.locked)?'selected':'' %>>Khóa</option></select><button class="btn btn-secondary">Lưu quyền</button></form></td><td><form method="post" action="/admin/users/<%= encodeURIComponent(u.username) %>/balance" class="inline-form"><input type="number" name="amount" placeholder="+/- số tiền" required><input name="note" placeholder="Lý do"><button class="btn">Điều chỉnh</button></form></td></tr><% }) %></tbody></table></div></section></main></body></html>