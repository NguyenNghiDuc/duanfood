<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Quên mật khẩu</title></head><body><main class="auth-shell"><section class="auth-card"><span class="eyebrow">KHÔI PHỤC TÀI KHOẢN</span><h1>Quên mật khẩu</h1><p>Nhập username để nhận mã khôi phục.</p><% if(error){ %><p class="notice error"><%= error %></p><% } %><% if(success){ %><p class="notice success"><%= success %></p><% } %><form method="post" action="/forgot-password"><label>Username<input name="username" autocomplete="username" required></label><button class="btn">Gửi mã</button></form><p><a href="/reset-password">Tôi đã có mã</a> · <a href="/login">Đăng nhập</a></p></section></main></body></html>