<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Lịch sử ví</title></head><body><main class="app-shell"><section class="page-card"><div class="page-heading"><div><span class="eyebrow">MINI FOOD WALLET</span><h1>Lịch sử ví</h1><p>Số dư hiện tại: <strong><%= Number(user.balance||0).toLocaleString('vi-VN') %>đ</strong></p></div><a class="btn" href="/wallet/top-up">Nạp tiền</a></div><div class="table-wrap"><table><thead><tr><th>Thời gian</th><th>Loại</th><th>Số tiền</th><th>Trước</th><th>Sau</th><th>Ghi chú</th></tr></thead><tbody><% transactions.forEach(t=>{ %><tr><td><%= t.created_at %></td><td><%= t.type %></td><td class="<%= Number(t.amount)>=0?'money-in':'money-out' %>"><%= Number(t.amount)>=0?'+':'' %><%= Number(t.amount).toLocaleString('vi-VN') %>đ</td><td><%= Number(t.balance_before).toLocaleString('vi-VN') %>đ</td><td><%= Number(t.balance_after).toLocaleString('vi-VN') %>đ</td><td><%= t.note||'' %></td></tr><% }) %></tbody></table></div></section></main></body></html>