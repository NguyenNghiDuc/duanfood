<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Đơn #<%= order.id %></title></head><body><main class="app-shell"><section class="page-card"><div class="page-heading"><div><span class="eyebrow">THEO DÕI ĐƠN HÀNG</span><h1>Đơn #<%= order.id %></h1><p><%= order.delivery_address||'' %></p></div><a class="btn btn-secondary" href="/orders">Tất cả đơn</a></div><div class="timeline"><% if(order.status==='Đã hủy'){ %><div class="timeline-cancelled"><strong>Đơn đã hủy</strong><p>Nếu đơn đủ điều kiện hoàn tiền, số tiền sẽ tự động về ví.</p></div><% } else { %><% statuses.forEach((status,index)=>{ %><div class="timeline-step <%= index<=current?'done':'' %> <%= index===current?'current':'' %>"><span class="timeline-dot"><%= index+1 %></span><div><strong><%= status %></strong><% if(index===current){ %><p>Cập nhật gần nhất: <%= order.status_updated_at||order.created_at %></p><% } %></div></div><% }) %><% } %></div><div class="summary-box"><p>Tiền hàng: <strong><%= Number(order.total||0).toLocaleString('vi-VN') %>đ</strong></p><p>Phí giao hàng: <strong><%= Number(order.shipping_fee||0).toLocaleString('vi-VN') %>đ</strong></p><p>Giảm giá: <strong>-<%= Number(order.discount_amount||0).toLocaleString('vi-VN') %>đ</strong></p><p>Thanh toán: <strong><%= order.payment_method %></strong></p></div></section></main></body></html>