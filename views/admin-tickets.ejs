<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Ticket CSKH</title></head><body><main class="app-shell"><section class="page-card"><div class="page-heading"><div><span class="eyebrow">CSKH ADMIN</span><h1>Ticket hỗ trợ</h1></div><a class="btn btn-secondary" href="/admin">Dashboard</a></div><div class="table-wrap"><table><thead><tr><th>ID</th><th>Khách</th><th>Tiêu đề</th><th>Trạng thái</th><th>Phụ trách</th><th>Cập nhật</th></tr></thead><tbody><% tickets.forEach(t=>{ %><tr><td>#<%= t.id %></td><td><%= t.username %></td><td><a href="/admin/tickets/<%= t.id %>"><strong><%= t.subject %></strong></a></td><td><span class="badge"><%= t.status %></span></td><td><%= t.assigned_to||'Chưa gán' %></td><td><%= t.updated_at||t.created_at %></td></tr><% }) %></tbody></table></div></section></main></body></html>