<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Thêm món ăn</title>
    <link rel="stylesheet" href="/css/add-food.css" />
  </head>
  <body>
    <main class="admin-page">
      <section class="card admin-card">
        <div class="admin-header">
          <div>
            <h1>Thêm món ăn mới</h1>
            <p>Nhập thông tin món ăn, giá, danh mục và hình ảnh để hiện trên trang.</p>
          </div>
          <div class="admin-actions">
            <a href="/foods" class="btn btn-secondary">Quay lại danh sách</a>
          </div>
        </div>

        <nav class="admin-breadcrumb">
          <a href="/">Trang chủ</a>
          <span>›</span>
          <a href="/foods">Món ăn</a>
          <span>›</span>
          <span>Thêm món ăn</span>
        </nav>

        <% if (error) { %>
          <div class="admin-alert error"><%= error %></div>
        <% } %>

        <form method="POST" action="/admin/foods" class="form-grid admin-form" id="add-food-form">
          <label>
            Tên món
            <input type="text" name="title" value="<%= formData.title || '' %>" maxlength="200" required />
          </label>

          <label>
            Giá (₫)
            <input type="number" name="price" min="1" step="1000" value="<%= formData.price || '' %>" required />
          </label>

          <label>
            Danh mục
            <select name="category_id" required>
              <option value="">-- Chọn danh mục --</option>
              <% categories.forEach(category => { %>
                <option value="<%= category.id %>" <%= String(formData.category_id || '') === String(category.id) ? 'selected' : '' %>><%= category.name %></option>
              <% }) %>
            </select>
          </label>

          <label>
            Mô tả
            <textarea name="description" rows="5" maxlength="2000"><%= formData.description || '' %></textarea>
          </label>

          <label>
            Nguyên liệu
            <textarea name="ingredients" rows="3" placeholder="Ví dụ: Bò, hành tây, phô mai, xốt BBQ"><%= formData.ingredients || '' %></textarea>
          </label>

          <label>
            Hình ảnh
            <input type="text" name="image" value="<%= formData.image || '' %>" placeholder="https://... hoặc /images/tenfile.png" />
          </label>

          <label>
            Số lượng
            <input type="number" name="quantity" min="0" step="1" value="<%= formData.quantity || 0 %>" />
          </label>

          <div class="admin-form-actions">
            <button type="submit" class="btn">Thêm món</button>
            <a href="/foods" class="btn btn-secondary btn-inline">Hủy</a>
          </div>
        </form>
      </section>
    </main>
  </body>
</html>
