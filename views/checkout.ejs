<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Thanh toán</title></head><body><main class="app-shell"><section class="page-card"><div class="page-heading"><div><span class="eyebrow">CHECKOUT</span><h1>Thanh toán</h1><p>Kiểm tra địa chỉ, vận chuyển, voucher và phương thức thanh toán.</p></div><a class="btn btn-secondary" href="/cart">← Giỏ hàng</a></div><% if(!cart||!cart.length){ %><div class="empty-state">Giỏ hàng đang trống. <a href="/foods">Đi chọn món</a></div><% }else{ %><% if(error){ %><p class="notice error"><%= error %></p><% } %><div class="dashboard-grid"><form method="post" action="/checkout" class="form-card" id="checkoutForm"><h2>Thông tin đơn hàng</h2><label>Địa chỉ giao hàng</label><div class="stack-list"><% (addresses||[]).forEach(a=>{ %><label class="notice-card"><input style="width:auto" type="radio" name="addressId" value="<%= a.id %>" <%= String(a.id)===String(selectedAddressId)?'checked':'' %> required><span><strong><%= a.label %><%= a.is_default?' · Mặc định':'' %></strong><br><small><%= a.full_name %> · <%= a.phone %><br><%= a.detail_address %>, <%= a.street %>, <%= a.ward %>, <%= a.district %>, <%= a.city %></small></span></label><% }) %></div><p><a href="/profile/addresses">Quản lý địa chỉ</a></p><label>Đơn vị vận chuyển<select name="deliveryCompanyId" id="deliveryCompanyId" required><option value="">Chọn đơn vị vận chuyển</option><% deliveryCompanies.forEach(c=>{ %><option value="<%= c.id %>" data-fee="<%= Number(c.fee||0) %>"><%= c.name %> — <%= Number(c.fee||0).toLocaleString('vi-VN') %>đ</option><% }) %></select></label><label>Voucher<div class="inline-form"><input name="voucherCode" id="voucherCode" placeholder="Nhập mã giảm giá"><button class="btn btn-secondary" type="button" id="previewVoucher">Kiểm tra</button></div><small id="voucherMessage"></small></label><label>Phương thức thanh toán<select name="paymentMethod" required><option value="COD">Thanh toán khi nhận hàng (COD)</option><option value="wallet">Thanh toán bằng ví</option><option value="Banking">Chuyển khoản ngân hàng</option><option value="Momo">Ví MoMo / chuyển khoản</option></select></label><button class="btn" <%= !(addresses&&addresses.length)?'disabled':'' %>>Xác nhận đặt hàng</button></form><aside class="panel"><h2>Tóm tắt</h2><div class="stack-list"><% cart.forEach(item=>{ %><div class="alert-row"><span><strong><%= item.title %></strong><br><small><%= item.quantity %> × <%= Number(item.price).toLocaleString('vi-VN') %>đ<% if(item.flashSale){ %> · 🔥 Flash Sale<% } %></small></span><strong><%= Number(item.price*item.quantity).toLocaleString('vi-VN') %>đ</strong></div><% }) %></div><hr><p>Tiền hàng: <strong id="subtotal" data-value="<%= Number(total||0) %>"><%= Number(total||0).toLocaleString('vi-VN') %>đ</strong></p><p>Giảm dự kiến: <strong id="discountPreview">0đ</strong></p><p>Số dư ví: <strong><%= Number((user&&user.balance)||0).toLocaleString('vi-VN') %>đ</strong></p><a class="btn btn-secondary" href="/wallet/top-up">Nạp ví</a></aside></div><% } %></section></main><script>document.getElementById('previewVoucher')?.addEventListener('click',async()=>{const code=document.getElementById('voucherCode').value;const total=Number(document.getElementById('subtotal').dataset.value||0);const r=await fetch('/voucher/preview',{method:'POST',headers:{'content-type':'application/json','accept':'application/json'},body:JSON.stringify({code,total})});const j=await r.json();document.getElementById('voucherMessage').textContent=j.message||'';document.getElementById('voucherMessage').style.color=j.ok?'var(--success)':'var(--danger)';document.getElementById('discountPreview').textContent=Number(j.discount||0).toLocaleString('vi-VN')+'đ';});</script></body></html>