<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Tồn kho</title></head><body><main class="app-shell"><section class="page-card"><div class="page-heading"><div><span class="eyebrow">KHO HÀNG</span><h1>Quản lý tồn kho</h1><p>Món dưới ngưỡng cảnh báo sẽ được đánh dấu.</p></div><a class="btn btn-secondary" href="/admin">Dashboard</a></div><div class="table-wrap"><table><thead><tr><th>Món</th><th>Danh mục</th><th>Giá</th><th>Tồn kho</th><th>Ngưỡng cảnh báo</th><th>Lưu</th></tr></thead><tbody><% foods.forEach(f=>{ %><tr class="<%= Number(f.stock)<=Number(f.low_stock_threshold)?'row-warning':'' %>"><td><strong><%= f.title %></strong></td><td><%= f.category_name||'' %></td><td><%= Number(f.price||0).toLocaleString('vi-VN') %>đ</td><form method="post" action="/admin/inventory/<%= f.id %>"><td><input type="number" name="stock" min="0" value="<%= f.stock %>" required></td><td><input type="number" name="low_stock_threshold" min="0" value="<%= f.low_stock_threshold %>" required></td><td><button class="btn">Cập nhật</button></td></form></tr><% }) %></tbody></table></div></section></main></body></html>