<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Business Insights</title></head><body><main class="app-shell"><section class="page-card"><div class="page-heading"><div><span class="eyebrow">BUSINESS INSIGHTS</span><h1>Dashboard nâng cao</h1><p>KPI bán hàng, khách hàng, doanh thu và tồn kho.</p></div><div class="actions"><a class="btn btn-secondary" href="/admin/export/orders">CSV đơn</a><a class="btn btn-secondary" href="/admin/export-excel/orders">Excel đơn</a><a class="btn btn-secondary" href="/admin/export/users">CSV user</a><a class="btn btn-secondary" href="/admin/export-excel/users">Excel user</a><a class="btn btn-secondary" href="/admin/export/wallet">CSV ví</a><a class="btn btn-secondary" href="/admin/export-excel/wallet">Excel ví</a></div></div><div class="metric-grid"><article class="metric-card"><span>Doanh thu</span><strong><%= Number(stats.revenue||0).toLocaleString('vi-VN') %>đ</strong></article><article class="metric-card"><span>Tổng đơn</span><strong><%= stats.total||0 %></strong></article><article class="metric-card"><span>AOV</span><strong><%= Number(stats.aov||0).toLocaleString('vi-VN') %>đ</strong></article><article class="metric-card"><span>Tỷ lệ hủy</span><strong><%= Number(stats.total)?((Number(stats.cancelled||0)/Number(stats.total))*100).toFixed(1):0 %>%</strong></article><article class="metric-card"><span>User gần đây</span><strong><%= stats.newUsers||0 %></strong></article></div><div class="dashboard-grid"><section class="panel" style="grid-column:1/-1"><h2>Doanh thu 30 ngày</h2><canvas id="dailyChart" height="90"></canvas></section><section class="panel" style="grid-column:1/-1"><h2>Doanh thu 12 tháng</h2><canvas id="monthlyChart" height="90"></canvas></section><section class="panel"><h2>Món bán chạy</h2><ol class="rank-list"><% topFoods.forEach(x=>{ %><li><span><%= x.title %></span><strong><%= x.qty %> phần</strong></li><% }) %></ol></section><section class="panel"><h2>Khách hàng giá trị cao</h2><ol class="rank-list"><% topUsers.forEach(x=>{ %><li><span><%= x.username %> · <%= x.orders %> đơn</span><strong><%= Number(x.spent||0).toLocaleString('vi-VN') %>đ</strong></li><% }) %></ol></section><section class="panel"><h2>Cảnh báo tồn kho</h2><div class="stack-list"><% if(!lowStock.length){ %><p>Không có món dưới ngưỡng.</p><% } %><% lowStock.forEach(x=>{ %><div class="alert-row"><span><%= x.title %></span><strong><%= x.stock %> còn lại</strong></div><% }) %></div></section><section class="panel"><h2>AI quản trị</h2><form id="adminAiForm"><input id="adminAiQuestion" placeholder="Ví dụ: doanh thu tuần này?"><button class="btn">Hỏi AI</button></form><div id="adminAiAnswer" class="ai-answer">Hỏi về doanh thu hôm nay/tuần/tháng, top món, tồn kho, số đơn hoặc khách hàng.</div></section></div></section></main><script>const daily=<%- JSON.stringify(revenueByDay||[]) %>,monthly=<%- JSON.stringify(revenueByMonth||[]) %>;function draw(canvas,data,labelKey){const ctx=canvas.getContext('2d'),dpr=window.devicePixelRatio||1,w=canvas.clientWidth||900,h=canvas.height;canvas.width=w*dpr;canvas.height=h*dpr;ctx.scale(dpr,dpr);const vals=data.map(x=>Number(x.revenue||0)),max=Math.max(...vals,1),pad=28,chartW=w-pad*2,chartH=h-pad*2;ctx.clearRect(0,0,w,h);ctx.strokeStyle='#d0d5dd';ctx.beginPath();ctx.moveTo(pad,pad);ctx.lineTo(pad,h-pad);ctx.lineTo(w-pad,h-pad);ctx.stroke();if(!data.length)return;ctx.strokeStyle='#ff6b35';ctx.lineWidth=2;ctx.beginPath();data.forEach((x,i)=>{const px=pad+(data.length===1?chartW/2:i*chartW/(data.length-1)),py=h-pad-(Number(x.revenue||0)/max)*chartH;if(i===0)ctx.moveTo(px,py);else ctx.lineTo(px,py)});ctx.stroke();ctx.fillStyle='#667085';ctx.font='11px sans-serif';const step=Math.max(1,Math.ceil(data.length/8));data.forEach((x,i)=>{if(i%step===0||i===data.length-1){const px=pad+(data.length===1?chartW/2:i*chartW/(data.length-1));ctx.fillText(String(x[labelKey]||'').slice(-5),Math.max(0,px-15),h-8)}})}draw(document.getElementById('dailyChart'),daily,'date');draw(document.getElementById('monthlyChart'),monthly,'month');window.addEventListener('resize',()=>{draw(document.getElementById('dailyChart'),daily,'date');draw(document.getElementById('monthlyChart'),monthly,'month')});document.getElementById('adminAiForm').addEventListener('submit',async e=>{e.preventDefault();const q=document.getElementById('adminAiQuestion').value,r=await fetch('/admin/ai/query',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({question:q})}),j=await r.json();document.getElementById('adminAiAnswer').textContent=j.answer||j.error||'Không có dữ liệu'});</script></body></html>