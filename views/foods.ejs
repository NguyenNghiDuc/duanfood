<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Danh sách món ăn</title></head><body><main class="app-shell"><section class="page-card"><div class="page-heading"><div><span class="eyebrow">MINI FOOD MENU</span><h1>Danh sách món ăn</h1><p>Tìm gần đúng, lọc giá/rating và sắp xếp theo số lượng bán thật.</p></div><div class="actions"><a class="btn btn-secondary" href="/favorites">Yêu thích</a><a class="btn btn-secondary" href="/cart">Giỏ hàng</a><% if(user&&user.role!=='user'){ %><a class="btn" href="/admin">Quản trị</a><% } %></div></div><form method="get" action="/foods" class="form-grid"><label>Tìm món<input name="keyword" value="<%= keyword||'' %>" placeholder="Ví dụ: pho bo, ga cay..."></label><label>Danh mục<select name="categoryId"><option value="">Tất cả</option><% categories.forEach(c=>{ %><option value="<%= c.id %>" <%= String(categoryId)===String(c.id)?'selected':'' %>><%= c.name %></option><% }) %></select></label><label>Giá từ<input type="number" name="minPrice" min="0" value="<%= typeof minPrice!=='undefined'&&minPrice!==null?minPrice:'' %>"></label><label>Giá đến<input type="number" name="maxPrice" min="0" value="<%= typeof maxPrice!=='undefined'&&maxPrice!==null?maxPrice:'' %>"></label><label>Rating tối thiểu<select name="minRating"><option value="">Tất cả</option><% [4,3,2,1].forEach(r=>{ %><option value="<%= r %>" <%= Number(minRating)===r?'selected':'' %>><%= r %>★ trở lên</option><% }) %></select></label><label>Sắp xếp<select name="sort"><option value="new" <%= sort==='new'?'selected':'' %>>Mới nhất</option><option value="price_asc" <%= sort==='price_asc'?'selected':'' %>>Giá thấp → cao</option><option value="price_desc" <%= sort==='price_desc'?'selected':'' %>>Giá cao → thấp</option><option value="rating" <%= sort==='rating'?'selected':'' %>>Rating cao</option><option value="popular" <%= sort==='popular'?'selected':'' %>>Bán chạy</option></select></label><button class="btn" style="align-self:end">Lọc món</button></form><% if(typeof fuzzy!=='undefined'&&fuzzy){ %><p class="notice success">Không thấy kết quả chính xác nên mình đã tìm các món có tên/từ khóa gần giống.</p><% } %><div class="product-grid"><% if(!(foods&&foods.length)){ %><div class="empty-state">Không tìm thấy món phù hợp.</div><% } %><% (foods||[]).forEach(food=>{ %><article class="product-card"><a href="/foods/<%= food.id %>"><% if(food.image){ %><img src="<%= food.image %>" alt="<%= food.title %>"><% } %></a><div class="product-card-body"><span class="badge"><%= food.category_name||'Món ăn' %></span><h3><a href="/foods/<%= food.id %>"><%= food.title %></a></h3><p><%= String(food.description||'').slice(0,120) %></p><% if(food.flash_sale){ %><small>🔥 Flash Sale · <del><%= Number(food.original_price||food.price).toLocaleString('vi-VN') %>đ</del></small><p class="price"><%= Number(food.display_price).toLocaleString('vi-VN') %>đ</p><% }else{ %><p class="price"><%= Number(food.display_price||food.price).toLocaleString('vi-VN') %>đ</p><% } %><p><small>⭐ <%= Number(food.avg_rating||0).toFixed(1) %> · đã bán <%= Number(food.sold_count||0) %> · còn <%= Number(food.stock??50) %></small></p><div class="actions"><form method="post" action="/cart/add/<%= food.id %>"><button class="btn" <%= Number(food.stock??50)<=0?'disabled':'' %>><%= Number(food.stock??50)<=0?'Hết hàng':'Thêm giỏ' %></button></form><% if(user){ %><form method="post" action="/favorites/<%= food.id %>/toggle"><button class="btn btn-secondary">♡</button></form><% } %><% if(user&&user.role!=='user'){ %><a class="btn btn-secondary" href="/admin/foods/edit/<%= food.id %>">Sửa</a><% } %></div></div></article><% }) %></div><% const baseQ=`keyword=${encodeURIComponent(keyword||'')}&categoryId=${encodeURIComponent(categoryId||'')}&minPrice=${minPrice??''}&maxPrice=${maxPrice??''}&minRating=${minRating??''}&sort=${encodeURIComponent(sort||'new')}`; %><nav class="page-nav"><% if(page>1){ %><a href="/foods?<%= baseQ %>&page=<%= page-1 %>">← Trang trước</a><% } %><span>Trang <strong><%= page %></strong></span><% if(hasNext){ %><a href="/foods?<%= baseQ %>&page=<%= page+1 %>">Trang sau →</a><% } %></nav></section></main></body></html>