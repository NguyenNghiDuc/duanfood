<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
      Danh sách món ăn
    </title>
    <link rel="stylesheet" href="/css/foods.css">
  </head>
  <body>
    <main class="food-page">
      <% if (user && user.role === 'admin') { %>
      <div class="admin-toolbar">
      </div>
      <nav class="admin-navigation">
        <a href="/" class="admin-nav-link">
          Trang chủ
        </a>
        <a href="/foods" class="admin-nav-link active">
          Món ăn
        </a>
        <a href="/admin/foods/add" class="admin-nav-link">
          Thêm món ăn
        </a>
        <a href="/admin/orders" class="admin-nav-link">
          Quản lý đơn hàng
        </a>
        <a href="/admin/categories" class="admin-nav-link">
          Quản lý danh mục
        </a>
        <a href="/admin/stats" class="admin-nav-link">
          Thống kê doanh thu
        </a>
        <a href="/logout" class="admin-nav-link">
          Đăng xuất
        </a>
      </nav>
      <div class="admin-actions">
        <span class="admin-greeting">
          Xin chào,
          <strong>
            <%= user.username %>
          </strong>
        </span>
      </div>
    </div>
    <% } %>
    <header class="food-header">
      <div>
        <h1>
          Danh sách món ăn
        </h1>
        <p>
          Tìm món, lọc theo danh mục và sắp xếp để đặt hàng nhanh chóng.
        </p>
      </div>
      <div class="food-header-actions">
        <a href="/" class="tab">
          Trang chủ
        </a>
        <a href="/foods?categoryId=&keyword=<%= encodeURIComponent(keyword || '') %>&sort=<%= sort || 'new' %>" class="tab <%= !categoryId ? 'active' : '' %>">
          Tất cả
        </a>
        <% categories.slice(0, 4).forEach(category => { %>
        <a href="/foods?categoryId=<%= category.id %>&keyword=<%= encodeURIComponent(keyword || '') %>&sort=<%= sort || 'new' %>" class="tab <%= String(categoryId) === String(category.id) ? 'active' : '' %>">
          <%= category.name %>
        </a>
        <% }) %>
      </div>
    </header>
    <form method="GET" action="/foods" class="food-filter">
      <input type="text" name="keyword" value="<%= keyword || '' %>
      " placeholder="Tìm món ăn..." >
      <select name="categoryId">
        <option value="">
          Tất cả danh mục
        </option>
        <% categories.forEach(category => { %>
        <option value="<%= category.id %>
          "
          <%= String(categoryId) === String(category.id) ? "selected" : "" %>
          >
          <%= category.name %>
        </option>
        <% }) %>
      </select>
      <select name="sort">
        <option value="new" <%= sort === 'new' ? 'selected' : '' %>
          >Mới nhất
        </option>
        <option value="priceLow" <%= sort === 'priceLow' ? 'selected' : '' %>
          >Giá thấp - cao
        </option>
        <option value="priceHigh" <%= sort === 'priceHigh' ? 'selected' : '' %>
          >Giá cao - thấp
        </option>
      </select>
      <button type="submit" class="btn btn-primary">
        Tìm kiếm
      </button>
    </form>
    <% if(foods && foods.length > 0){ %>
    <ul class="food-list">
      <% foods.forEach(food => { %>
      <li>
        <div class="food-detail-image">
          <% if(food.image){ %>
          <img src="<%= food.image %>
          " alt="
          <%= food.title %>
          ">
          <% } else { %>
          <img src="/images/default-food.jpg" alt="<%= food.title %>
          ">
          <% } %>
          <span class="food-tag">
            <%= food.category_name || 'Món mới' %>
          </span>
        </div>
        <div class="food-card-body">
          <h3>
            <%= food.title %>
          </h3>
          <p class="food-description">
            <%= food.description %>
          </p>
          <% if (food.gram) { %>
          <p class="food-weight">
            <%= food.gram %> g
          </p>
          <% } %>
          <div class="food-price-row">
            <strong class="food-price">
              <%= Number(food.price).toLocaleString('vi-VN') %>
              ₫
            </strong>
            <span class="food-rating">
              ⭐ 4.8
            </span>
          </div>
          <div class="food-actions">
            <form method="POST" action="/cart/add/<%= food.id %>
              ">
              <button type="submit" class="btn btn-primary">
                + Thêm vào giỏ
              </button>
            </form>
            <% if(user && user.role === "admin"){ %>
            <div class="admin-food-actions">
              <a href="/admin/foods/edit/<%= food.id %>
                " class="btn btn-secondary"> Chỉnh sửa
              </a>
              <form method="POST" action="/admin/foods/delete/<%= food.id %>
                " onsubmit="return confirm('Bạn có chắc muốn xóa món này?')" >
                <button type="submit" class="delete-btn">
                  Xóa
                </button>
              </form>
            </div>
            <% } %>
          </div>
        </div>
      </li>
      <% }) %>
    </ul>
    <% } else { %>
    <h2 style="text-align:center; margin-top:50px;">
      Chưa có món ăn nào
    </h2>
    <% } %>
  </main>
</body>
</html>
