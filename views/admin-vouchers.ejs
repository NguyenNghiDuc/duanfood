<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Voucher</title></head><body><main class="app-shell"><section class="page-card"><div class="page-heading"><div><span class="eyebrow">ADMIN</span><h1>Voucher & mã giảm giá</h1></div><a class="btn btn-secondary" href="/admin">Dashboard</a></div><form method="post" action="/admin/vouchers" class="form-grid"><label>Mã<input name="code" required></label><label>Loại<select name="discount_type"><option value="percent">%</option><option value="fixed">Giảm tiền</option></select></label><label>Giá trị<input type="number" name="discount_value" min="0" required></label><label>Đơn tối thiểu<input type="number" name="min_order" min="0" value="0"></label><label>Giảm tối đa<input type="number" name="max_discount" min="0" value="0"></label><label>Giới hạn lượt<input type="number" name="usage_limit" min="0" value="0"></label><label>Bắt đầu<input type="datetime-local" name="starts_at"></label><label>Hết hạn<input type="datetime-local" name="expires_at"></label><button class="btn">Tạo voucher</button></form><div class="table-wrap"><table><thead><tr><th>Mã</th><th>Giảm</th><th>Điều kiện</th><th>Lượt dùng</th><th>Thời gian</th><th>Trạng thái</th></tr></thead><tbody><% vouchers.forEach(v=>{ %><tr><td><strong><%= v.code %></strong></td><td><%= v.discount_type==='fixed'?Number(v.discount_value).toLocaleString('vi-VN')+'đ':v.discount_value+'%' %></td><td>Min <%= Number(v.min_order||0).toLocaleString('vi-VN') %>đ</td><td><%= v.used_count %>/<%= Number(v.usage_limit||0)||'∞' %></td><td><small><%= v.starts_at||'Ngay' %><br>→ <%= v.expires_at||'Không giới hạn' %></small></td><td><form method="post" action="/admin/vouchers/<%= v.id %>/toggle"><button class="btn <%= Number(v.active)?'':'btn-secondary' %>"><%= Number(v.active)?'Đang bật':'Đã tắt' %></button></form></td></tr><% }) %></tbody></table></div></section></main></body></html>