<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Thông báo</title></head><body><main class="app-shell"><section class="page-card"><div class="page-heading"><div><span class="eyebrow">TRUNG TÂM THÔNG BÁO</span><h1>Thông báo của bạn</h1></div><a class="btn btn-secondary" href="/">Trang chủ</a></div><div class="stack-list"><% if(!items.length){ %><div class="empty-state">Chưa có thông báo.</div><% } %><% items.forEach(item=>{ %><article class="notice-card <%= Number(item.is_read)?'':'unread' %>" data-notification-id="<%= item.id %>"><div><h3><%= item.title %></h3><p><%= item.message %></p><small><%= item.created_at %></small></div><div class="actions"><% if(item.link){ %><a class="btn btn-secondary" href="<%= item.link %>">Mở</a><% } %><% if(!Number(item.is_read)){ %><button class="btn" onclick="markRead(<%= item.id %>,this)">Đã đọc</button><% } %></div></article><% }) %></div></section></main><script>async function markRead(id,btn){await fetch('/notifications/'+id+'/read',{method:'POST',headers:{Accept:'application/json'}});btn.closest('.notice-card').classList.remove('unread');btn.remove()}</script></body></html>