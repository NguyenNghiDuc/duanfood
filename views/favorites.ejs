<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Món yêu thích</title></head><body><main class="app-shell"><section class="page-card"><div class="page-heading"><div><span class="eyebrow">MINI FOOD</span><h1>Món yêu thích</h1><p>Lưu các món bạn muốn đặt lại nhanh.</p></div><a class="btn btn-secondary" href="/foods">Khám phá món</a></div><div class="product-grid"><% if(!foods.length){ %><div class="empty-state">Chưa có món yêu thích.</div><% } %><% foods.forEach(food=>{ %><article class="product-card"><% if(food.image){ %><img src="<%= food.image %>" alt="<%= food.title %>"><% } %><div class="product-card-body"><h3><a href="/foods/<%= food.id %>"><%= food.title %></a></h3><p class="price"><%= Number(food.price||0).toLocaleString('vi-VN') %>đ</p><div class="actions"><form method="post" action="/cart/add/<%= food.id %>"><button class="btn">Thêm giỏ</button></form><form method="post" action="/favorites/<%= food.id %>/toggle"><button class="btn btn-secondary">Bỏ yêu thích</button></form></div></div></article><% }) %></div></section></main></body></html>