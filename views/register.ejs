<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng ký tài khoản</title>
    <link rel="stylesheet" href="/css/register.css">
</head>
<body>

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <span class="auth-icon">🍃</span>
            <h1>Đăng ký tài khoản</h1>
        </div>

        <p class="auth-subtitle">Tạo tài khoản để đặt món và nhận nhiều ưu đãi hấp dẫn từ Food.</p>

        <% if(error){ %>
            <div class="error-box">
                <%= error %>
            </div>
        <% } %>

        <form method="POST" action="/register" class="auth-form">

            <div class="field-row">
                <div class="form-group">
                    <label>Họ và tên</label>
                    <input type="text" name="fullname" placeholder="Nhập họ và tên" required>
                </div>
                <div class="form-group">
                    <label>Số điện thoại</label>
                    <input type="text" name="phone" placeholder="Nhập số điện thoại">
                </div>
            </div>

            <div class="form-group">
                <label>Email</label>
                <input type="email" name="username" placeholder="Nhập email của bạn" required>
            </div>

            <div class="form-group">
                <label>Địa chỉ</label>
                <textarea name="address" rows="3" placeholder="Nhập địa chỉ của bạn"></textarea>
            </div>

            <div class="field-row">
                <div class="form-group">
                    <label>Mật khẩu</label>
                    <input type="password" name="password" placeholder="Nhập mật khẩu" required>
                </div>
                <div class="form-group">
                    <label>Xác nhận mật khẩu</label>
                    <input type="password" name="confirmPassword" placeholder="Nhập lại mật khẩu" required>
                </div>
            </div>

            <label class="checkbox-row">
                <input type="checkbox" name="terms">
                Tôi đồng ý với <a href="#">Điều khoản dịch vụ</a> và <a href="#">Chính sách bảo mật</a>
            </label>

            <label class="checkbox-row checkbox-secondary">
                <input type="checkbox" name="newsletter">
                Đăng ký nhận thông tin khuyến mãi và tin tức mới nhất
            </label>

            <button type="submit" class="btn btn-primary">
                Đăng ký tài khoản
            </button>
        </form>

        <div class="auth-footer">
            Đã có tài khoản?
            <a href="/login">Đăng nhập ngay</a>
        </div>

        <div class="back-home">
            <a href="/">← Quay về trang chủ</a>
        </div>
    </div>
</div>

</body>
</html>