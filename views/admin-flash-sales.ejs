<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Flash Sale</title></head><body><main class="app-shell"><section class="page-card"><div class="page-heading"><div><span class="eyebrow">ADMIN</span><h1>Flash Sale</h1></div><a class="btn btn-secondary" href="/admin">Dashboard</a></div><form method="post" action="/admin/flash-sales" class="form-grid"><label>Món<select name="food_id" required><% foods.forEach(f=>{ %><option value="<%= f.id %>"><%= f.title %> — <%= Number(f.price).toLocaleString('vi-VN') %>đ</option><% }) %></select></label><label>Giá sale<input type="number" name="sale_price" min="1" required></label><label>Bắt đầu<input type="datetime-local" name="starts_at" required></label><label>Kết thúc<input type="datetime-local" name="ends_at" required></label><button class="btn">Tạo flash sale</button></form><div class="table-wrap"><table><thead><tr><th>Món</th><th>Giá gốc</th><th>Giá sale</th><th>Bắt đầu</th><th>Kết thúc</th><th>Trạng thái</th></tr></thead><tbody><% sales.forEach(s=>{ %><tr><td><%= s.title %></td><td><%= Number(s.price).toLocaleString('vi-VN') %>đ</td><td><strong><%= Number(s.sale_price).toLocaleString('vi-VN') %>đ</strong></td><td><%= s.starts_at %></td><td><%= s.ends_at %></td><td><%= Number(s.active)?'Bật':'Tắt' %></td></tr><% }) %></tbody></table></div></section></main></body></html>