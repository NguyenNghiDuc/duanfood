<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>CSKH</title></head><body><main class="app-shell"><section class="page-card"><div class="page-heading"><div><span class="eyebrow">CSKH</span><h1>Hỗ trợ khách hàng</h1><p>Khi AI không giải quyết được, bạn có thể gửi ticket để nhân viên hỗ trợ trực tiếp.</p></div></div><div class="support-layout"><aside class="support-sidebar"><form method="post" action="/support" class="form-card"><h3>Tạo yêu cầu mới</h3><label>Tiêu đề<input name="subject" maxlength="200" required></label><label>Nội dung<textarea name="message" rows="5" required></textarea></label><button class="btn">Gửi CSKH</button></form><div class="stack-list"><% tickets.forEach(t=>{ %><a class="ticket-link <%= activeTicket&&Number(activeTicket.id)===Number(t.id)?'active':'' %>" href="/support/<%= t.id %>"><strong>#<%= t.id %> · <%= t.subject %></strong><span><%= t.status %></span></a><% }) %></div></aside><section class="support-chat"><% if(activeTicket){ %><div class="page-heading compact"><div><h2>#<%= activeTicket.id %> · <%= activeTicket.subject %></h2><p>Trạng thái: <strong><%= activeTicket.status %></strong></p></div></div><div class="chat-thread"><% messages.forEach(m=>{ %><div class="chat-bubble <%= m.sender_role==='user'?'from-user':'from-staff' %>"><strong><%= m.sender_role==='user'?'Bạn':m.sender %></strong><p><%= m.message %></p><small><%= m.created_at %></small></div><% }) %></div><% if(activeTicket.status!=='closed'){ %><form method="post" action="/support/<%= activeTicket.id %>/reply" class="reply-box"><textarea name="message" rows="3" placeholder="Nhập phản hồi..." required></textarea><button class="btn">Gửi</button></form><% } %><% }else{ %><div class="empty-state">Chọn một ticket để xem cuộc trò chuyện.</div><% } %></section></div></section></main></body></html>