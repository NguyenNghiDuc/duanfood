<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Khách <%= customer.username %></title></head><body><main class="app-shell"><section class="page-card"><div class="page-heading"><div><span class="eyebrow">CUSTOMER 360</span><h1><%= customer.username %></h1><p><%= customer.fullname||'' %> · <%= customer.email||'' %> · <%= customer.phone||'' %></p></div><a class="btn btn-secondary" href="/admin/users">← Người dùng</a></div><div class="metric-grid"><article class="metric-card"><span>Số dư</span><strong><%= Number(customer.balance||0).toLocaleString('vi-VN') %>đ</strong></article><article class="metric-card"><span>Role</span><strong><%= customer.role %></strong></article><article class="metric-card"><span>Tài khoản</span><strong><%= Number(customer.locked)?'Đang khóa':'Hoạt động' %></strong></article><article class="metric-card"><span>Số đơn</span><strong><%= orders.length %></strong></article></div><div class="dashboard-grid"><section class="panel"><h2>Đơn hàng gần đây</h2><div class="table-wrap"><table><thead><tr><th>ID</th><th>Tổng</th><th>Giảm</th><th>Trạng thái</th><th>Ngày</th></tr></thead><tbody><% orders.forEach(o=>{ %><tr><td>#<%= o.id %></td><td><%= Number(o.total||0).toLocaleString('vi-VN') %>đ</td><td><%= Number(o.discount_amount||0).toLocaleString('vi-VN') %>đ</td><td><%= o.status %></td><td><%= o.created_at %></td></tr><% }) %></tbody></table></div></section><section class="panel"><h2>Lịch sử ví</h2><div class="table-wrap"><table><thead><tr><th>Loại</th><th>Tiền</th><th>Sau GD</th><th>Ngày</th></tr></thead><tbody><% transactions.forEach(t=>{ %><tr><td><%= t.type %></td><td class="<%= Number(t.amount)>=0?'money-in':'money-out' %>"><%= Number(t.amount)>=0?'+':'' %><%= Number(t.amount).toLocaleString('vi-VN') %>đ</td><td><%= Number(t.balance_after).toLocaleString('vi-VN') %>đ</td><td><%= t.created_at %></td></tr><% }) %></tbody></table></div></section></div></section></main></body></html>