<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Đơn hàng</title></head><body><main class="app-shell"><section class="page-card"><div class="page-heading"><div><span class="eyebrow">LỊCH SỬ ĐƠN HÀNG</span><h1>Đơn hàng của bạn</h1></div><a class="btn btn-secondary" href="/foods">Đặt thêm món</a></div><div class="stack-list"><% if(!(orders&&orders.length)){ %><div class="empty-state">Bạn chưa có đơn hàng nào.</div><% } %><% (orders||[]).forEach(order=>{ const payable=Math.max(0,Number(order.total||0)+Number(order.shipping_fee||0)-Number(order.discount_amount||0)); %><article class="notice-card"><div><h3>Đơn #<%= order.id %></h3><p><strong><%= order.status %></strong> · <%= new Date(order.created_at).toLocaleString('vi-VN') %></p><p>Thanh toán: <%= order.payment_method %><% if(order.voucher_code){ %> · Voucher <strong><%= order.voucher_code %></strong><% } %></p><p>Tổng phải trả: <strong><%= payable.toLocaleString('vi-VN') %>đ</strong><% if(Number(order.discount_amount||0)>0){ %> · đã giảm <%= Number(order.discount_amount).toLocaleString('vi-VN') %>đ<% } %></p></div><div class="actions"><a class="btn btn-secondary" href="/orders/<%= order.id %>/timeline">Theo dõi</a><form method="post" action="/orders/<%= order.id %>/reorder"><button class="btn">Mua lại</button></form></div></article><% }) %></div></section></main></body></html>