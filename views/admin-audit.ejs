<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Audit log</title></head><body><main class="app-shell"><section class="page-card"><div class="page-heading"><div><span class="eyebrow">SECURITY</span><h1>Audit log</h1><p>Theo dõi thao tác quản trị quan trọng.</p></div><a class="btn btn-secondary" href="/admin">Dashboard</a></div><div class="table-wrap"><table><thead><tr><th>Thời gian</th><th>Người thao tác</th><th>Hành động</th><th>Đối tượng</th><th>Chi tiết</th></tr></thead><tbody><% logs.forEach(l=>{ %><tr><td><%= l.created_at %></td><td><strong><%= l.actor %></strong></td><td><%= l.action %></td><td><%= l.target_type %> <%= l.target_id %></td><td><small><%= l.detail||'' %></small></td></tr><% }) %></tbody></table></div></section></main></body></html>