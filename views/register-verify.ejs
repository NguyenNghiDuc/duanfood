<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Xác thực OTP</title>
    <link rel="stylesheet" href="/css/register.css" />
  </head>
  <body>
    <%
      const safePhone = typeof phone !== 'undefined' && phone ? phone : '';
      const safeError = typeof error !== 'undefined' ? error : null;
      const safeOtpSent = typeof otpSent !== 'undefined' ? Boolean(otpSent) : false;
      const safeDevOtp = typeof devOtp !== 'undefined' ? devOtp : null;
    %>
    <div class="auth-container">
      <div class="auth-card auth-card-compact">
        <div class="auth-header">
          <span class="auth-icon">🔒</span>
          <h1>Xác thực số điện thoại</h1>
        </div>

        <% if (safeOtpSent) { %>
          <p class="auth-subtitle">Mã OTP đã được gửi tới <strong><%= safePhone %></strong>. Vui lòng nhập đủ 6 số để hoàn tất đăng ký.</p>
          <div class="success-box">SMS OTP đã được Twilio chấp nhận gửi.</div>
        <% } else { %>
          <p class="auth-subtitle">SMS OTP chưa được gửi thành công tới <strong><%= safePhone %></strong>.</p>
        <% } %>

        <% if (safeError) { %>
          <div class="error-box"><%= safeError %></div>
        <% } %>

        <% if (safeDevOtp) { %>
          <div class="dev-otp-box">
            <span>Mã OTP test (development)</span>
            <strong><%= safeDevOtp %></strong>
            <small>Dùng đúng 6 số này để đăng ký. Khi chạy production, mã OTP sẽ không bao giờ hiển thị trên web.</small>
          </div>
        <% } %>

        <form method="POST" action="/register/verify" class="auth-form otp-form">
          <div class="form-group">
            <label>Mã OTP 6 số</label>
            <input
              type="text"
              name="otp"
              inputmode="numeric"
              autocomplete="one-time-code"
              maxlength="6"
              pattern="[0-9]{6}"
              title="Vui lòng nhập đúng 6 chữ số OTP"
              placeholder="••••••"
              oninvalid="this.setCustomValidity('Vui lòng nhập đúng mã OTP gồm 6 chữ số.')"
              oninput="this.setCustomValidity(''); this.value=this.value.replace(/[^0-9]/g,'').slice(0,6)"
              required
            />
          </div>
          <button type="submit" class="btn btn-primary">Xác nhận OTP</button>
        </form>

        <div class="auth-footer">
          <a href="/register">← Nhập lại thông tin / số điện thoại</a>
        </div>
      </div>
    </div>
  </body>
</html>
