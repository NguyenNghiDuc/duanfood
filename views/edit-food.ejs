<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Chỉnh sửa món ăn</title>
    <link rel="stylesheet" href="/css/add-food.css" />
  </head>
  <body>
    <main class="admin-page">
      <section class="card admin-card">
        <div class="admin-header">
          <div>
            <h1>Chỉnh sửa món ăn</h1>
            <p>Cập nhật thông tin món ăn và đổi ảnh nếu cần.</p>
          </div>
          <div class="admin-actions">
            <a href="/foods" class="btn btn-secondary">Quay lại danh sách</a>
          </div>
        </div>

        <nav class="admin-breadcrumb">
          <a href="/">Trang chủ</a>
          <span>›</span>
          <a href="/foods">Món ăn</a>
          <span>›</span>
          <span>Chỉnh sửa món ăn</span>
        </nav>

        <% if (error) { %>
          <div class="admin-alert error"><%= error %></div>
        <% } %>

        <form method="POST" action="/admin/foods/edit/<%= food.id %>" class="form-grid admin-form" id="edit-food-form">
          <label>
            Tên món
            <input type="text" name="title" value="<%= formData.title || food.title || '' %>" maxlength="200" required />
          </label>

          <label>
            Giá (₫)
            <input type="number" name="price" min="1" step="1000" value="<%= formData.price ?? Number(food.price || 0) %>" required />
          </label>

          <label>
            Danh mục
            <select name="category_id" required>
              <% categories.forEach(category => { %>
                <option value="<%= category.id %>" <%= String((formData.category_id ?? food.category_id) || '') === String(category.id) ? 'selected' : '' %>><%= category.name %></option>
              <% }) %>
            </select>
          </label>

          <label>
            Mô tả
            <textarea name="description" rows="5" maxlength="2000"><%= formData.description ?? (food.description || '') %></textarea>
          </label>

          <label>
            Nguyên liệu
            <textarea name="ingredients" rows="3"><%= formData.ingredients || '' %></textarea>
          </label>

          <label>
            Hình ảnh
            <input type="text" name="image" value="<%= formData.image ?? (food.image || '') %>" placeholder="https://... hoặc /images/tenfile.png" />
          </label>

          <label>
            Số lượng
            <input type="number" name="quantity" min="0" step="1" value="<%= formData.quantity ?? Number(food.gram || 0) %>" />
          </label>

          <div class="admin-form-actions">
            <button type="submit" class="btn">Cập nhật món</button>
            <a href="/foods" class="btn btn-secondary btn-inline">Hủy</a>
          </div>
        </form>
      </section>
    </main>
  </body>
</html>
