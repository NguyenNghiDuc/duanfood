# =========================================================
# MINI FOOD - ENVIRONMENT TEMPLATE
# Copy: cp .env.example .env
# IMPORTANT: never commit your real .env or API secrets.
# =========================================================

# ---------------------------------------------------------
# APP / SESSION
# ---------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=5000

# REQUIRED in production. Replace with a long random value.
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
SESSION_STORE=database
SESSION_TTL_MS=604800000
TRUST_PROXY=1

# ---------------------------------------------------------
# DATABASE
# ---------------------------------------------------------
# 0 = SQLite (recommended for local/Codespaces quick start)
# 1 = MySQL
USE_MYSQL=0

# MySQL (used only when USE_MYSQL=1)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=mini_food
DB_POOL_SIZE=10

# SQLite
SQLITE_PATH=./data/fallback.db

# ---------------------------------------------------------
# EMAIL / PASSWORD RESET
# ---------------------------------------------------------
# Option A: Resend. Leave blank if not using real email yet.
RESEND_API_KEY=
EMAIL_FROM=MINI FOOD <no-reply@example.com>

# Option B: custom email webhook fallback
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=

# ---------------------------------------------------------
# SMS OTP / TWILIO
# ---------------------------------------------------------
# For REAL SMS, all 3 values below are required.
# Example TWILIO_FROM: +12345678900
# Vietnam numbers entered as 09xxxxxxxx are normalized to +849xxxxxxxx.
# In NODE_ENV=development, if these values are blank, the OTP is shown
# on the verification page for local testing instead of pretending SMS sent.
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# TEST ONLY. The app only honors this when NODE_ENV=test.
TEST_OTP=123456

# ---------------------------------------------------------
# CLOUDINARY IMAGE STORAGE
# ---------------------------------------------------------
# Leave blank for local public/uploads storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------
# VNPAY
# ---------------------------------------------------------
# Leave VNP_TMN_CODE and VNP_HASH_SECRET blank until you have sandbox keys.
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# Local browser:
VNP_RETURN_URL=http://localhost:5000/payments/vnpay/return
# GitHub Codespaces: replace VNP_RETURN_URL with your forwarded HTTPS port URL,
# e.g. https://YOUR-CODESPACE-5000.app.github.dev/payments/vnpay/return

# ---------------------------------------------------------
# AI / RAG
# ---------------------------------------------------------
# Ollama defaults. These can remain even when Ollama is not running;
# lexical/RAG fallbacks keep the food assistant usable where supported.
AI_BASE_URL=http://127.0.0.1:11434
AI_MODEL=llama3.2:3b
AI_EMBEDDING_MODEL=nomic-embed-text
AI_EMBEDDING_URL=http://127.0.0.1:11434/api/embeddings
AI_EMBEDDING_TOKEN=
RAG_MIN_SCORE=0.36
RAG_ANSWER_SCORE=0.55
RAG_REBUILD_ON_START=0

# ---------------------------------------------------------
# MONITORING / METRICS
# ---------------------------------------------------------
# Optional token protecting metrics endpoint where configured.
METRICS_TOKEN=

# Optional external error webhook.
ERROR_WEBHOOK_URL=
ERROR_WEBHOOK_TOKEN=

# ---------------------------------------------------------
# SEED / DEMO ACCOUNTS
# ---------------------------------------------------------
# Change these before using seed outside a local demo environment.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_USER_USERNAME=demo
SEED_USER_PASSWORD=Demo12345!
