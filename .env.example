# App
NODE_ENV=development
HOST=0.0.0.0
PORT=5000
SESSION_SECRET=change-me-with-a-long-random-secret
SESSION_STORE=database
SESSION_TTL_MS=604800000
TRUST_PROXY=1

# Database
USE_MYSQL=0
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=mini_food
DB_POOL_SIZE=10
SQLITE_PATH=./data/fallback.db

# Email (Resend recommended)
RESEND_API_KEY=
EMAIL_FROM=MINI FOOD <no-reply@example.com>
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=

# SMS OTP (optional Twilio)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# Cloudinary (optional; local uploads remain available without these)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# VNPay
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:5000/payments/vnpay/return

# AI / RAG
AI_BASE_URL=http://127.0.0.1:11434
AI_MODEL=llama3.2:3b
AI_EMBEDDING_MODEL=nomic-embed-text
AI_EMBEDDING_URL=http://127.0.0.1:11434/api/embeddings
AI_EMBEDDING_TOKEN=
RAG_MIN_SCORE=0.36
RAG_ANSWER_SCORE=0.55

# Optional monitoring webhook
ERROR_WEBHOOK_URL=
ERROR_WEBHOOK_TOKEN=

# Seed/demo
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_USER_USERNAME=demo
SEED_USER_PASSWORD=Demo12345!
